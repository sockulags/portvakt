# Copy to .env for local development. Never commit real secrets.
# Every value below is a development value. With NODE_ENV=production the server refuses to start
# with the dev MASTER_KEY, MASTER_KEY_PREVIOUS or COOKIE_KEYS below, a development database
# password, one database role for both URLs, or a PUBLIC_URL that is not https or points at
# localhost / .test.

NODE_ENV=development
PORT=3000
# An origin without a path. Issuers are {PUBLIC_URL}/t/{tenantSlug}; endpoint URLs and cookie
# security always follow it, never the request's Host or X-Forwarded-* headers.
# Defaults to http://localhost:{PORT} outside production.
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
# Proxy hops trusted for X-Forwarded-For (the client IP): false (default), true, or a hop count
# (1-99). Host and protocol never come from forwarded headers (see PUBLIC_URL).
TRUST_PROXY=false
# Apply pending migrations at start-up. Default: true outside production, false in production
# (run `npm run migrate -w apps/server` as a separate step instead).
MIGRATE_ON_START=

# Token and session lifetimes (durations as below). Sessions and refresh tokens follow the
# session policy of the login method used (maxAge, idle, allowSso); SESSION_TTL is the ceiling
# for a login method's maxAge (refused at write time) and REFRESH_TOKEN_TTL for refresh tokens.
# INTERACTION_TTL also bounds how long an upstream login may take.
ACCESS_TOKEN_TTL=5m
ID_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=8h
SESSION_TTL=8h
INTERACTION_TTL=15m

# Upstream federation (login methods). ACR_RANKING orders assurance levels, lowest first
# (comma-separated); acr_values requests are matched against it. Default: the Swedish eID
# Framework levels loa2, loa3, loa4.
ACR_RANKING=http://id.elegnamnden.se/loa/1.0/loa2,http://id.elegnamnden.se/loa/1.0/loa3,http://id.elegnamnden.se/loa/1.0/loa4
# Timeout of each request to an upstream IdP, and how long its discovered metadata is reused.
UPSTREAM_TIMEOUT=10s
UPSTREAM_METADATA_TTL=1h
# A failed discovery is not retried for this long (0 disables the failure cache).
UPSTREAM_FAILURE_CACHE=5s
# Built login UI (npm run build -w apps/login). Default: apps/login/dist. Production refuses to
# start without it.
LOGIN_UI_DIR=

# Background work. Every replica reloads providers and keys on change notifications, and every
# PROVIDER_RELOAD_INTERVAL as a fallback. Key rotation and cleanup run on one replica at a time.
PROVIDER_RELOAD_INTERVAL=30s
KEY_ROTATION_CHECK_INTERVAL=1h
PAYLOAD_CLEANUP_INTERVAL=15m
# How often SAML IdP metadata URLs are checked for a due refresh (each SAML login method
# refreshes after its own metadataRefreshSeconds, default 1h; a failed refresh keeps the last good
# metadata and is retried after 5 minutes). Logins never fetch metadata while a cached copy exists.
SAML_METADATA_CHECK_INTERVAL=5m
# Cached SAML metadata without a validUntil is used at most this long after its last successful
# refresh; then the login method fails closed until a refresh succeeds.
SAML_METADATA_MAX_AGE=7d
# Largest number of XML elements in a SAML Response Portvakt parses (100 to 1000000). Responses
# are also capped at 512 KB and depth 64.
SAML_XML_MAX_ELEMENTS=20000
# Requests to configured URLs (SAML metadata, upstream OIDC, client jwks_uri) never reach loopback,
# private, link-local or other special-use addresses, except these hosts (comma-separated):
# development only, refused in production. The local mock IdP needs them.
ALLOW_PRIVATE_UPSTREAM_HOSTS=localhost,127.0.0.1
# Graceful shutdown: how long in-flight requests may take after SIGTERM.
SHUTDOWN_TIMEOUT=15s
# Graceful shutdown: readiness reports 503 for this long before the listener closes, so load
# balancers stop sending new requests first. 0 disables the wait.
SHUTDOWN_DRAIN_DELAY=5s

# Dev database (started with `npm run db:up`, Postgres 16 on host port 5433). Two roles:
# the app runs as the restricted portvakt_app (DML only; audit_events SELECT/INSERT only) and
# migrations run as the owner portvakt, which grants portvakt_app its privileges.
DATABASE_URL=postgres://portvakt_app:portvakt_app@localhost:5433/portvakt
# Defaults to DATABASE_URL outside production; required (and a different role) in production.
MIGRATION_DATABASE_URL=postgres://portvakt:portvakt@localhost:5433/portvakt
# Runtime pool size per replica (at least 2). See CLAUDE.md, "Capacity planning".
# Runtime pool size per replica (at least 2); see CLAUDE.md, "Capacity planning".
DATABASE_POOL_MAX=10
# Audit events older than this are deleted by `npm run audit:prune -w apps/server` (run it on a
# schedule; it connects with MIGRATION_DATABASE_URL, the only role allowed to delete them).
# Default 400d, at least 90d.
AUDIT_RETENTION=400d

# Test database used by integration tests. Tests create and drop schemas in it,
# so never point this at a database holding data you care about.
TEST_DATABASE_URL=postgres://portvakt_app:portvakt_app@localhost:5433/portvakt_test
TEST_MIGRATION_DATABASE_URL=postgres://portvakt:portvakt@localhost:5433/portvakt_test

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts client secrets, private signing keys and personal identity numbers (AES-256-GCM
# envelopes), and derives the blind-index key used to look personal identity numbers up.
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlISE=
# Master key rotation: move the old key here (comma-separated), set a new MASTER_KEY, run
# `npm run rewrap-secrets -w apps/server`, then remove the old key.
MASTER_KEY_PREVIOUS=

# Comma-separated cookie signing keys for oidc-provider; the first signs, all verify.
# Production: at least 32 characters each.
COOKIE_KEYS=dev-only-cookie-key-1-do-not-use-in-production,dev-only-cookie-key-2-do-not-use-in-production

# Signing key rotation (durations: s, m, h, d, w; combinable, e.g. 1h30m).
KEY_ROTATION_INTERVAL=90d
KEY_PUBLISH_AHEAD=2d
# Must be at least the longest signed token lifetime (ACCESS_TOKEN_TTL, ID_TOKEN_TTL) and
# SESSION_TTL (ID tokens return as id_token_hint at logout).
KEY_RETIRE_AFTER=2d

# First-start bootstrap (empty database): system tenant, portvakt-admin application, this
# login method, and a platform-admin rule for BOOTSTRAP_ADMIN_SUBJECT. Used from M2/M6 on.
BOOTSTRAP_IDP_ISSUER=
BOOTSTRAP_IDP_CLIENT_ID=
BOOTSTRAP_IDP_CLIENT_SECRET=
# Default: openid profile email
BOOTSTRAP_IDP_SCOPES=
# employee (default) or citizen
BOOTSTRAP_IDP_KIND=
BOOTSTRAP_IDP_DISPLAY_NAME=
BOOTSTRAP_IDP_ACR=
BOOTSTRAP_ADMIN_SUBJECT=

# Mock IdP (apps/mock-idp, development and tests only; refuses NODE_ENV=production).
# Issuers {MOCK_IDP_PUBLIC_URL}/entra and {MOCK_IDP_PUBLIC_URL}/bankid. Without MOCK_IDP_CLIENTS
# it accepts client "portvakt-dev" (secrets dev-only-entra-client-secret and
# dev-only-bankid-client-secret) for every redirect URI below http://localhost:3000/t/.
MOCK_IDP_PORT=4500
MOCK_IDP_PUBLIC_URL=http://localhost:4500
# Path of a personas file (default apps/mock-idp/personas.json).
MOCK_IDP_PERSONAS=
# JSON array of clients, or the path of a JSON file with one (see apps/mock-idp/src/clients.ts).
MOCK_IDP_CLIENTS=

# Local stack (`npm run dev:stack`): Portvakt on :3000, the mock IdP on :4500, the demo service
# as Service A on :3100 and Service B on :3200. `npm run seed:dev -w apps/server` creates the
# `demo` tenant (issuer http://localhost:3000/t/demo) with applications service-a and service-b;
# these secrets are set on them by the seed and passed to the demo instances. Without them the
# seed generates secrets for new applications and prints them once.
DEMO_SERVICE_A_CLIENT_SECRET=dev-only-service-a-client-secret-0123456789
DEMO_SERVICE_B_CLIENT_SECRET=dev-only-service-b-client-secret-0123456789
# Seed defaults (override only when the mock IdP or the demo run elsewhere):
# MOCK_IDP_ENTRA_CLIENT_SECRET=dev-only-entra-client-secret
# MOCK_IDP_BANKID_CLIENT_SECRET=dev-only-bankid-client-secret
# DEMO_SERVICE_A_URL=http://localhost:3100
# DEMO_SERVICE_B_URL=http://localhost:3200

# The demo service (examples/demo-service) reads only its own variables, set per instance by
# dev:stack: APP_NAME, PORT, PUBLIC_URL, ISSUER, CLIENT_ID, CLIENT_SECRET, COOKIE_NAME (must
# differ per instance: cookies on localhost are shared across ports), and optionally
# COOKIE_SECRET, SESSION_ENCRYPTION_KEY (32 bytes, base64; development defaults are refused in
# production), STEP_UP_ACR (default loa4), SCOPES, OUTAGE_GRACE_SECONDS, IDLE_TIMEOUT_SECONDS.
