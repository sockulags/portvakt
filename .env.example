# Copy to .env for local development. Never commit real secrets.
# Every value below is a development value. With NODE_ENV=production the server refuses to start
# with the dev MASTER_KEY, MASTER_KEY_PREVIOUS or COOKIE_KEYS below, a development database
# password, one database role for both URLs, a PUBLIC_URL that is not https or points at
# localhost / .test, unprotected metrics, or one value used for two secrets.
# `npm run config:check -w apps/server` lists every problem of a configuration (names only).
# NODE_ENV development and test only run with a loopback or *.localhost PUBLIC_URL: every other
# host needs NODE_ENV=production.

NODE_ENV=development
PORT=3000
# An origin without a path. Issuers are {PUBLIC_URL}/t/{tenantSlug}; endpoint URLs and cookie
# security always follow it, never the request's Host or X-Forwarded-* headers.
# Defaults to http://localhost:{PORT} outside production.
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
# Proxy hops trusted for X-Forwarded-For (the client IP): false (default), true, or a hop count
# (1-99). Host and protocol never come from forwarded headers (see PUBLIC_URL).
TRUST_PROXY=false
# Apply pending migrations at start-up. Default: true outside production, false in production
# (run `npm run migrate -w apps/server` as a separate step instead).
MIGRATE_ON_START=

# Token and session lifetimes (durations as below). Sessions and refresh tokens follow the
# session policy of the login method used (maxAge, idle, allowSso); SESSION_TTL is the ceiling
# for a login method's maxAge (refused at write time) and REFRESH_TOKEN_TTL for refresh tokens.
# INTERACTION_TTL also bounds how long an upstream login may take.
ACCESS_TOKEN_TTL=5m
ID_TOKEN_TTL=5m
REFRESH_TOKEN_TTL=8h
SESSION_TTL=8h
INTERACTION_TTL=15m

# Upstream federation (login methods). ACR_RANKING orders assurance levels, lowest first
# (comma-separated); acr_values requests are matched against it. Default: the Swedish eID
# Framework levels loa2, loa3, loa4.
ACR_RANKING=http://id.elegnamnden.se/loa/1.0/loa2,http://id.elegnamnden.se/loa/1.0/loa3,http://id.elegnamnden.se/loa/1.0/loa4
# Timeout of each request to an upstream IdP, and how long its discovered metadata is reused.
UPSTREAM_TIMEOUT=10s
UPSTREAM_METADATA_TTL=1h
# A failed discovery is not retried for this long (0 disables the failure cache).
UPSTREAM_FAILURE_CACHE=5s
# Built login UI (npm run build -w apps/login). Default: apps/login/dist. Production refuses to
# start without it.
LOGIN_UI_DIR=

# Background work. Every replica reloads providers and keys on change notifications, and every
# PROVIDER_RELOAD_INTERVAL as a fallback. Key rotation and cleanup run on one replica at a time.
PROVIDER_RELOAD_INTERVAL=30s
KEY_ROTATION_CHECK_INTERVAL=1h
PAYLOAD_CLEANUP_INTERVAL=15m
# How often SAML IdP metadata URLs are checked for a due refresh (each SAML login method
# refreshes after its own metadataRefreshSeconds, default 1h; a failed refresh keeps the last good
# metadata and is retried after 5 minutes). Logins never fetch metadata while a cached copy exists.
SAML_METADATA_CHECK_INTERVAL=5m
# Cached SAML metadata without a validUntil is used at most this long after its last successful
# refresh; then the login method fails closed until a refresh succeeds.
SAML_METADATA_MAX_AGE=7d
# Largest number of XML elements in a SAML Response Portvakt parses (100 to 1000000). Responses
# are also capped at 512 KB and depth 64.
SAML_XML_MAX_ELEMENTS=20000
# Requests to configured URLs (SAML metadata, upstream OIDC, client jwks_uri) never reach loopback,
# private, link-local or other special-use addresses, except these hosts (comma-separated):
# development only, refused in production. The local mock IdP needs them.
ALLOW_PRIVATE_UPSTREAM_HOSTS=localhost,127.0.0.1
# Graceful shutdown: how long in-flight requests may take after SIGTERM.
SHUTDOWN_TIMEOUT=15s
# Graceful shutdown: readiness reports 503 for this long before the listener closes, so load
# balancers stop sending new requests first. 0 disables the wait.
SHUTDOWN_DRAIN_DELAY=5s

# HTTP limits. requestTimeout covers the whole request (headers and body), headersTimeout the
# headers (at most the request timeout); keep-alive connections live HTTP_KEEP_ALIVE_TIMEOUT,
# longer than the load balancer's idle timeout (60 s on most), so it never reuses one Node has
# just closed. Longer URLs get 414, larger header blocks 431. Bodies have per-route limits
# (interaction API 4 KB, token endpoints 56 KB, SAML ACS 1 MB, SAML SLO 128 KB, admin API 11 MB
# for inline SAML metadata).
HTTP_REQUEST_TIMEOUT=30s
HTTP_HEADERS_TIMEOUT=20s
HTTP_KEEP_ALIVE_TIMEOUT=65s
MAX_URL_LENGTH=8192
HTTP_MAX_HEADER_SIZE=16384

# Rate limits, per replica, in memory (token buckets): <count>/<period> (60/1m, 10/30s, 1000/1h)
# or off. With N replicas a client gets up to N times these; put an ingress limit in front as
# well (docs/threat-model.md). The client IP is the one TRUST_PROXY resolves. Refusals answer
# 429 with Retry-After (OAuth error JSON on the token endpoints, the login UI's page on
# authorization and upstream callbacks, problem+json on the admin API) and are counted in
# portvakt_rate_limited_total. Empty: the defaults shown.
#   authorization requests per client IP, and per tenant and client_id
RATE_LIMIT_AUTHORIZE_IP=
RATE_LIMIT_AUTHORIZE_CLIENT=
#   interaction API per client IP (login method choice, home realm lookup, representation, abort)
RATE_LIMIT_INTERACTION_IP=
#   upstream OIDC callbacks, SAML ACS and SLO per client IP
RATE_LIMIT_FEDERATION_IP=
#   token, introspection, revocation and PAR endpoints per client IP, then per tenant and client_id
RATE_LIMIT_TOKEN_IP=
RATE_LIMIT_TOKEN_CLIENT=
#   admin API per administrator (failed authentications: per client IP)
RATE_LIMIT_ADMIN_API=
# Defaults: AUTHORIZE_IP 120/1m, AUTHORIZE_CLIENT 3000/1m, INTERACTION_IP 60/1m,
# FEDERATION_IP 120/1m, TOKEN_IP 600/1m, TOKEN_CLIENT 1200/1m, ADMIN_API 600/1m.

# Prometheus metrics at /metrics: on the main port behind METRICS_TOKEN (bearer, at least 32
# characters in production), or on a port of their own (METRICS_PORT, METRICS_HOST; do not
# expose it through the ingress). Production refuses metrics on the main port without a token
# (METRICS_ENABLED=false turns them off). Labels carry route templates, reason codes and
# configuration ids, never personal data.
METRICS_ENABLED=
METRICS_PORT=
METRICS_HOST=
METRICS_TOKEN=

# Dev database (started with `npm run db:up`, Postgres 16 on host port 5433). Two roles:
# the app runs as the restricted portvakt_app (DML only; audit_events SELECT/INSERT only) and
# migrations run as the owner portvakt, which grants portvakt_app its privileges.
DATABASE_URL=postgres://portvakt_app:portvakt_app@localhost:5433/portvakt
# Defaults to DATABASE_URL outside production; required (and a different role) in production.
MIGRATION_DATABASE_URL=postgres://portvakt:portvakt@localhost:5433/portvakt
# Runtime pool size per replica (at least 2); see CLAUDE.md, "Capacity planning".
DATABASE_POOL_MAX=10
# Session limits of the runtime role's connections: a statement running longer is cancelled, a
# connection idle inside a transaction this long is closed (so no stuck caller holds locks), and
# acquiring a pool connection gives up after DATABASE_CONNECTION_TIMEOUT.
DATABASE_STATEMENT_TIMEOUT=15s
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT=60s
DATABASE_CONNECTION_TIMEOUT=5s
# Audit events older than this are deleted by `npm run audit:prune -w apps/server` (run it on a
# schedule; it connects with MIGRATION_DATABASE_URL, the only role allowed to delete them).
# Default 400d, at least 90d.
AUDIT_RETENTION=400d

# Test database used by integration tests. Tests create and drop schemas in it,
# so never point this at a database holding data you care about.
TEST_DATABASE_URL=postgres://portvakt_app:portvakt_app@localhost:5433/portvakt_test
TEST_MIGRATION_DATABASE_URL=postgres://portvakt:portvakt@localhost:5433/portvakt_test

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts client secrets, private signing keys and personal identity numbers (AES-256-GCM
# envelopes), and derives the blind-index key used to look personal identity numbers up.
MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlISE=
# Master key rotation: move the old key here (comma-separated), set a new MASTER_KEY, run
# `npm run rewrap-secrets -w apps/server`, then remove the old key.
MASTER_KEY_PREVIOUS=

# Comma-separated cookie signing keys for oidc-provider; the first signs, all verify.
# Production: at least 32 characters each.
COOKIE_KEYS=dev-only-cookie-key-1-do-not-use-in-production,dev-only-cookie-key-2-do-not-use-in-production

# Signing key rotation (durations: s, m, h, d, w; combinable, e.g. 1h30m).
KEY_ROTATION_INTERVAL=90d
KEY_PUBLISH_AHEAD=2d
# Must be at least the longest signed token lifetime (ACCESS_TOKEN_TTL, ID_TOKEN_TTL) and
# SESSION_TTL (ID tokens return as id_token_hint at logout).
KEY_RETIRE_AFTER=2d
# A manual rotation in the admin portal or API (without emergency) publishes the new key at once
# and activates it this much later, so every verifier has fetched it before it signs. Production
# requires at least 390s: the SDKs' default JWKS cache (5 minutes), their refetch cooldown (30 s)
# and the JWKS max-age (60 s). An emergency rotation activates at once.
KEY_MANUAL_PUBLISH_AHEAD=10m

# First-start bootstrap. When the database has no tenants at all, the server creates (once, under
# an advisory lock, audited as admin.bootstrap): the `system` tenant, the `portvakt-admin`
# application (redirect URIs {ADMIN_PUBLIC_URL}/t/{tenant}/auth/callback, client secret
# ADMIN_CLIENT_SECRET), enabled in `system`, an OIDC login method from BOOTSTRAP_IDP_* (its issuer
# checked by the outbound guard), and a pending platform-admin assignment for
# BOOTSTRAP_ADMIN_SUBJECT (the upstream subject, claim BOOTSTRAP_IDP_SUBJECT_CLAIM, at that method)
# or BOOTSTRAP_ADMIN_PIN (needs BOOTSTRAP_IDP_PIN_CLAIM; the method then trusts the number, so its
# BOOTSTRAP_IDP_ACR must be at least loa3 with BOOTSTRAP_IDP_ACR_CLAIM). The assignment becomes
# the person's at their first sign-in. Never runs again once a tenant exists. In development the
# dev seed (npm run seed:dev) sets up the system tenant instead and leaves these empty.
# Example for the mock IdP: BOOTSTRAP_IDP_ISSUER=http://localhost:4500/entra,
# BOOTSTRAP_IDP_CLIENT_ID=portvakt-dev, BOOTSTRAP_IDP_CLIENT_SECRET=dev-only-entra-client-secret,
# BOOTSTRAP_IDP_SUBJECT_CLAIM=oid, BOOTSTRAP_ADMIN_SUBJECT=a3d9e0f4-71c2-4b8e-b5a6-2c4f9d1e8b77.
BOOTSTRAP_IDP_ISSUER=
BOOTSTRAP_IDP_CLIENT_ID=
BOOTSTRAP_IDP_CLIENT_SECRET=
# Default: openid profile email
BOOTSTRAP_IDP_SCOPES=
# employee (default) or citizen
BOOTSTRAP_IDP_KIND=
BOOTSTRAP_IDP_DISPLAY_NAME=
# Default urn:portvakt:acr:employee
BOOTSTRAP_IDP_ACR=
# Upstream claims: subject (default sub), name (default name), email (default email), personal
# identity number and acr (none by default).
BOOTSTRAP_IDP_SUBJECT_CLAIM=
BOOTSTRAP_IDP_NAME_CLAIM=
BOOTSTRAP_IDP_EMAIL_CLAIM=
BOOTSTRAP_IDP_PIN_CLAIM=
BOOTSTRAP_IDP_ACR_CLAIM=
# true: map email without email_verified (Entra ID work accounts)
BOOTSTRAP_IDP_TRUST_EMAIL=
# Exactly one of these two.
BOOTSTRAP_ADMIN_SUBJECT=
BOOTSTRAP_ADMIN_PIN=

# Admin portal (apps/admin, a deployable of its own: npm run start -w apps/admin, :3400).
# ADMIN_PUBLIC_URL is read by both the server (bootstrap redirect URIs) and the portal; default
# http://localhost:3400 outside production. ADMIN_CLIENT_SECRET is the portvakt-admin client
# secret: the bootstrap registers it and the portal authenticates with it (required in production
# for the bootstrap; without it the development bootstrap generates one and prints it once).
ADMIN_PUBLIC_URL=http://localhost:3400
ADMIN_CLIENT_SECRET=dev-only-admin-client-secret-0123456789abcdef
# The lowest level of assurance (a value of ACR_RANKING) the admin API accepts; tokens of a lower
# or unranked acr are refused (403 acr_too_low). Recommended in production (config:check warns
# when unset), for example http://id.elegnamnden.se/loa/1.0/loa3. Empty: no minimum.
ADMIN_MIN_ACR=
# The portal's own settings: port, Portvakt's PUBLIC_URL (tenant issuers {PORTVAKT_PUBLIC_URL}/t/{slug};
# defaults to PUBLIC_URL outside production), where it reaches the admin API (default
# PORTVAKT_PUBLIC_URL), cookie and session keys (development defaults are refused in production),
# Postgres for sessions (required in production; `npm run migrate-sessions -w apps/admin` creates
# the table portvakt_admin_sessions with ADMIN_MIGRATION_DATABASE_URL), the tenant `/` opens.
ADMIN_PORT=3400
PORTVAKT_PUBLIC_URL=
ADMIN_API_URL=
ADMIN_COOKIE_SECRET=
ADMIN_SESSION_ENCRYPTION_KEY=
ADMIN_DATABASE_URL=
# Per client IP and replica: lookups of tenant slugs the portal does not know yet (each asks
# Portvakt's discovery); answered 429 above it. ADMIN_API_URL must be https in production.
ADMIN_RATE_LIMIT_TENANT_LOOKUP=
ADMIN_MIGRATION_DATABASE_URL=
ADMIN_DEFAULT_TENANT=system
# The portal's client IP (rate limits): proxy hops trusted for X-Forwarded-For (false, true or a
# number). Sign-in starts and callbacks per client IP and replica (ADMIN_RATE_LIMIT_LOGIN,
# default 30/1m, or off). /metrics (ADMIN_METRICS_ENABLED, default true) needs
# ADMIN_METRICS_TOKEN in production. ADMIN_LOG_LEVEL: info by default.
ADMIN_TRUST_PROXY=
ADMIN_RATE_LIMIT_LOGIN=
ADMIN_METRICS_ENABLED=
ADMIN_METRICS_TOKEN=
ADMIN_LOG_LEVEL=

# Mock IdP (apps/mock-idp, development and tests only; refuses NODE_ENV=production).
# Issuers {MOCK_IDP_PUBLIC_URL}/entra and {MOCK_IDP_PUBLIC_URL}/bankid. Without MOCK_IDP_CLIENTS
# it accepts client "portvakt-dev" (secrets dev-only-entra-client-secret and
# dev-only-bankid-client-secret) for every redirect URI below http://localhost:3000/t/.
MOCK_IDP_PORT=4500
MOCK_IDP_PUBLIC_URL=http://localhost:4500
# Path of a personas file (default apps/mock-idp/personas.json).
MOCK_IDP_PERSONAS=
# JSON array of clients, or the path of a JSON file with one (see apps/mock-idp/src/clients.ts).
MOCK_IDP_CLIENTS=

# Local stack (`npm run dev:stack`): Portvakt on :3000, the mock IdP on :4500, the demo service
# as Service A on :3100 and Service B on :3200. `npm run seed:dev -w apps/server` creates the
# `demo` tenant (issuer http://localhost:3000/t/demo) with applications service-a, service-b and
# service-c (the Java demo, examples/demo-service-java, on :3300); these secrets are set on them
# by the seed and passed to the demo instances. Without them the seed generates secrets for new
# applications and prints them once.
DEMO_SERVICE_A_CLIENT_SECRET=dev-only-service-a-client-secret-0123456789
DEMO_SERVICE_B_CLIENT_SECRET=dev-only-service-b-client-secret-0123456789
DEMO_SERVICE_C_CLIENT_SECRET=dev-only-service-c-client-secret-0123456789
# Seed defaults (override only when the mock IdP or the demo run elsewhere):
# MOCK_IDP_ENTRA_CLIENT_SECRET=dev-only-entra-client-secret
# MOCK_IDP_BANKID_CLIENT_SECRET=dev-only-bankid-client-secret
# DEMO_SERVICE_A_URL=http://localhost:3100
# DEMO_SERVICE_B_URL=http://localhost:3200
# DEMO_SERVICE_C_URL=http://localhost:3300
# SEED_ISOLATION_TENANT=   (a second tenant with service-c enabled; npm run test:java sets it)
# DEMO_SERVICE_D_PUBLIC_JWK=  (service-d, the Java demo with private_key_jwt on :3301; npm run
#                              test:java sets it with a key made for the run)

# The demo service (examples/demo-service) reads only its own variables, set per instance by
# dev:stack: APP_NAME, PORT, PUBLIC_URL, ISSUER, CLIENT_ID, CLIENT_SECRET, COOKIE_NAME (must
# differ per instance: cookies on localhost are shared across ports), and optionally
# COOKIE_SECRET, SESSION_ENCRYPTION_KEY (32 bytes, base64; development defaults are refused in
# production), STEP_UP_ACR (default loa4), SCOPES, OUTAGE_GRACE_SECONDS, IDLE_TIMEOUT_SECONDS.
