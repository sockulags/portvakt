# Copy to .env for local development. Never commit real secrets.

# Dev database (started with `npm run db:up`, Postgres 16 on host port 5433).
DATABASE_URL=postgres://portvakt:portvakt@localhost:5433/portvakt

# Test database used by integration tests. Tests may create and drop schemas in it,
# so never point this at a database holding data you care about.
TEST_DATABASE_URL=postgres://portvakt:portvakt@localhost:5433/portvakt_test
