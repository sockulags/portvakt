{
  "name": "@portvakt/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Admin portal: Express BFF (Portvakt SDK) and React SPA, a separate deployable.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env src/main.ts",
    "build": "vite build --config web/vite.config.ts",
    "watch": "vite build --config web/vite.config.ts --watch",
    "migrate-sessions": "tsx --env-file-if-exists=../../.env src/migrate-sessions.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json"
  },
  "dependencies": {
    "@portvakt/sdk-node": "*",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@portvakt/design-system": "*",
    "@portvakt/fonts": "*",
    "@portvakt/mock-idp": "*",
    "@portvakt/server": "*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.4"
  }
}
