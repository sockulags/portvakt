# The end-to-end stack's URLs and client secrets (deploy/docker-compose.e2e.yml), read after
# deploy/compose/local.env. The ports are those of `npm run test:e2e` (e2e/src/env.ts defaults).

PORTVAKT_PUBLIC_URL=http://localhost:3800
ADMIN_PUBLIC_URL=http://localhost:3840
ADMIN_CLIENT_SECRET=e2e-only-admin-client-secret-0123456789abcdef
MOCK_IDP_PORT=4800
MOCK_IDP_PUBLIC_URL=http://localhost:4800
DEMO_SERVICE_A_PORT=3810
DEMO_SERVICE_B_PORT=3820
DEMO_SERVICE_A_URL=http://localhost:3810
DEMO_SERVICE_B_URL=http://localhost:3820
DEMO_SERVICE_C_URL=http://localhost:3830
DEMO_SERVICE_A_CLIENT_SECRET=e2e-only-service-a-client-secret-0123456789
DEMO_SERVICE_B_CLIENT_SECRET=e2e-only-service-b-client-secret-0123456789
DEMO_SERVICE_C_CLIENT_SECRET=e2e-only-service-c-client-secret-0123456789
