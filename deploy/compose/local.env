# Development values for deploy/docker-compose.local.yml (local evaluation) and
# deploy/docker-compose.e2e.yml (the end-to-end suite). Every value is a development value from
# .env.example or made for this file: Portvakt refuses all of them with NODE_ENV=production.
# Never use this file for a deployment (deploy/compose/production.env.example is the template).

PORTVAKT_DB_HOST=localhost
POSTGRES_PASSWORD=dev-only-postgres-superuser
PORTVAKT_OWNER_DB_PASSWORD=portvakt
PORTVAKT_APP_DB_PASSWORD=portvakt_app
PORTVAKT_ADMIN_OWNER_DB_PASSWORD=dev-only-portvakt-admin-owner
PORTVAKT_ADMIN_DB_PASSWORD=dev-only-portvakt-admin

PORTVAKT_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3400

MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlISE=
COOKIE_KEYS=dev-only-cookie-key-1-do-not-use-in-production,dev-only-cookie-key-2-do-not-use-in-production
ADMIN_CLIENT_SECRET=dev-only-admin-client-secret-0123456789abcdef
ADMIN_COOKIE_SECRET=dev-only-admin-cookie-secret-do-not-use-in-production
ADMIN_SESSION_ENCRYPTION_KEY=ZGV2LW9ubHktYWRtaW4tc2Vzc2lvbi1rZXktMzJieXQ=

ALLOW_PRIVATE_UPSTREAM_HOSTS=localhost,127.0.0.1
MOCK_IDP_PUBLIC_URL=http://localhost:4500
MOCK_IDP_ENTRA_CLIENT_SECRET=dev-only-entra-client-secret
MOCK_IDP_BANKID_CLIENT_SECRET=dev-only-bankid-client-secret
DEMO_SERVICE_A_CLIENT_SECRET=dev-only-service-a-client-secret-0123456789
DEMO_SERVICE_B_CLIENT_SECRET=dev-only-service-b-client-secret-0123456789
DEMO_SERVICE_C_CLIENT_SECRET=dev-only-service-c-client-secret-0123456789
