# Template for deploy/docker-compose.yml in production mode. Copy it to
# deploy/compose/production.env (ignored by git), fill in every value, and keep the file as
# secret as the values (or set them in the environment instead). docs/operations.md explains
# each variable; generate every secret separately (production refuses reused values):
#
#   openssl rand -base64 32   MASTER_KEY, ADMIN_SESSION_ENCRYPTION_KEY
#   openssl rand -hex 32      COOKIE_KEYS, ADMIN_CLIENT_SECRET, ADMIN_COOKIE_SECRET,
#                             METRICS_TOKEN, ADMIN_METRICS_TOKEN
#   openssl rand -hex 24      the database passwords (they go into URLs: hex stays URL-safe)
#
# Keep MASTER_KEY in a secret manager as well: the database is unusable without it.

# Image tag (and registry prefix with a trailing slash, when the images come from a registry).
PORTVAKT_TAG=1.0.0
PORTVAKT_REGISTRY=

# Database: the superuser and the four Portvakt roles (created on the first start of the
# volume by deploy/compose/postgres-init). Owner passwords go only to the one-off jobs.
POSTGRES_PASSWORD=
PORTVAKT_OWNER_DB_PASSWORD=
PORTVAKT_APP_DB_PASSWORD=
PORTVAKT_ADMIN_OWNER_DB_PASSWORD=
PORTVAKT_ADMIN_DB_PASSWORD=

# Public https origins, served by your TLS proxy in front of 127.0.0.1:3000 and :3400.
PORTVAKT_PUBLIC_URL=https://login.example.org
ADMIN_PUBLIC_URL=https://admin.login.example.org
# Proxy hops in front of Portvakt and the portal (the client IP of rate limits).
TRUST_PROXY=1
ADMIN_TRUST_PROXY=1

MASTER_KEY=
COOKIE_KEYS=
METRICS_TOKEN=
ADMIN_CLIENT_SECRET=
ADMIN_COOKIE_SECRET=
ADMIN_SESSION_ENCRYPTION_KEY=
ADMIN_METRICS_TOKEN=
# Recommended: http://id.elegnamnden.se/loa/1.0/loa3 (with a bootstrap IdP that asserts it).
ADMIN_MIN_ACR=

# Audit events older than this are deleted by the `audit-prune` job (profile `jobs`; schedule
# `docker compose ... run --rm audit-prune` daily on the host). At least 90d.
AUDIT_RETENTION=400d

# The first platform administrator (docs/operations.md, "Bootstrap"), for example Entra ID with
# the issuer of your own tenant (https://login.microsoftonline.com/{tenant id}/v2.0; the
# multi-tenant /common and /organizations issuers are refused). Read only at the very first
# start, on a database without tenants. With ADMIN_MIN_ACR set, BOOTSTRAP_IDP_ACR must rank at
# least as high (a ranked level also needs BOOTSTRAP_IDP_ACR_CLAIM), or the first administrator
# is refused by the admin API; `config:check` warns about it.
BOOTSTRAP_IDP_ACR=
BOOTSTRAP_IDP_ACR_CLAIM=
BOOTSTRAP_IDP_ISSUER=
BOOTSTRAP_IDP_CLIENT_ID=
BOOTSTRAP_IDP_CLIENT_SECRET=
BOOTSTRAP_IDP_KIND=employee
BOOTSTRAP_IDP_DISPLAY_NAME=
BOOTSTRAP_IDP_TRUST_EMAIL=
BOOTSTRAP_ADMIN_SUBJECT=
