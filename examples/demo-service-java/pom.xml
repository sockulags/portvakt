<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>se.portvakt</groupId>
    <artifactId>portvakt-sdk-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../sdk-java/pom.xml</relativePath>
  </parent>

  <artifactId>portvakt-demo-service-java</artifactId>
  <name>Portvakt demo service (Java)</name>
  <description>
    The Java demo service ("Tjänst C"): browser login, step-up, representation and an API through
    the Portvakt Spring Boot starter. Its integration tests run against a real Portvakt
    (npm run test:java).
  </description>

  <properties>
    <!-- The design system's tokens, copied at build time (never forked). -->
    <design-system.dir>${project.basedir}/../../packages/design-system/src</design-system.dir>
    <!-- Integration tests skip without a Portvakt unless this is true (npm run test:java). -->
    <portvakt.it.required>false</portvakt.it.required>
  </properties>

  <dependencies>
    <dependency>
      <groupId>se.portvakt</groupId>
      <artifactId>portvakt-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-design-tokens</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static/css</outputDirectory>
              <resources>
                <resource>
                  <directory>${design-system.dir}</directory>
                  <includes>
                    <include>tokens.css</include>
                  </includes>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!--
          tokens.css imports its fonts from Google Fonts; the demo loads nothing from third parties
          (CSP default-src 'self'), so the import line is dropped from the copy and the token font
          stacks fall back to system fonts. The token values themselves are untouched.
        -->
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>drop-remote-font-import</id>
            <phase>process-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <replaceregexp file="${project.build.outputDirectory}/static/css/tokens.css"
                               match="@import\s+url\(\s*[&quot;']?https?:[^)]*\)\s*;?"
                               replace="/* remote font import removed at build time */"
                               flags="g"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <!-- The repackaged (executable) jar hides the classes: test against target/classes. -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
          <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
          <systemPropertyVariables>
            <portvakt.it.required>${portvakt.it.required}</portvakt.it.required>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
