{
  "name": "@portvakt/demo-service",
  "version": "1.0.0",
  "private": true,
  "description": "Demo downstream service, run as Service A and Service B.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@portvakt/sdk-node": "*",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@portvakt/design-system": "*",
    "@portvakt/fonts": "*",
    "@portvakt/mock-idp": "*",
    "@portvakt/server": "*",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.4"
  },
  "scripts": {
    "dev": "tsx watch --conditions=portvakt-source src/main.ts",
    "start": "tsx --conditions=portvakt-source src/main.ts",
    "build": "npm run build:web && tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts"
  }
}
