{
  "name": "portvakt",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant identity broker: federates upstream identity providers and issues OIDC tokens per tenant.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*",
    "e2e"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=6",
    "test:watch": "vitest",
    "test:e2e": "npm run test --workspace e2e",
    "build": "npm run build --workspaces --if-present",
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f deploy/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
