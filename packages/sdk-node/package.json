{
  "name": "@portvakt/sdk-node",
  "version": "1.0.0",
  "description": "Portvakt SDK for Node and Express: backend-for-frontend login, access token validation and service-to-service tokens.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "portvakt-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/tsconfig.build.tsbuildinfo",
    "src",
    "!src/**/*.test.ts",
    "!src/testing",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@portvakt/mock-idp": "*",
    "@portvakt/server": "*",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "express": "^5.3.0",
    "express4": "npm:express@^4.21.2",
    "pg": "^8.23.1"
  },
  "keywords": [
    "oidc",
    "bff",
    "express",
    "jwt",
    "portvakt"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
