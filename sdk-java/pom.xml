<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>se.portvakt</groupId>
  <artifactId>portvakt-sdk-parent</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <name>Portvakt Java SDK (parent)</name>
  <description>Portvakt SDK for Java 21: core token validation and a Spring Boot 4 starter.</description>
  <licenses>
    <license>
      <name>MIT</name>
    </license>
  </licenses>

  <modules>
    <module>portvakt-sdk-core</module>
    <module>portvakt-spring-boot-starter</module>
    <module>../examples/demo-service-java</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Dependencies (checked on Maven Central, 2026-10-19). -->
    <!-- Spring Boot 4.1 (Spring Framework 7, Spring Security 7.1); JUnit and AssertJ from its BOM. -->
    <spring-boot.version>4.1.1</spring-boot.version>
    <!-- The version Spring Security 7.1.1 declares: one Nimbus for the core and Spring. -->
    <nimbus-jose-jwt.version>10.9.1</nimbus-jose-jwt.version>

    <!-- Plugins. -->
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.0</maven-failsafe-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
    <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
    <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>

    <!--
      Where `mvn -Prelease deploy` publishes the SDK. No real repository is configured: the default
      is a staging directory in target/. Override both on the command line, for example
      -Dportvakt.release.repository.id=central
      -Dportvakt.release.repository.url=https://repo.example.org/releases
      (credentials for the id go into settings.xml, never into this file).
    -->
    <portvakt.release.repository.id>portvakt-staging</portvakt.release.repository.id>
    <portvakt.release.repository.url>file://${maven.multiModuleProjectDirectory}/target/staging-repository</portvakt.release.repository.url>
    <portvakt.snapshot.repository.id>portvakt-staging</portvakt.snapshot.repository.id>
    <portvakt.snapshot.repository.url>file://${maven.multiModuleProjectDirectory}/target/staging-repository</portvakt.snapshot.repository.url>
  </properties>

  <distributionManagement>
    <repository>
      <id>${portvakt.release.repository.id}</id>
      <url>${portvakt.release.repository.url}</url>
    </repository>
    <snapshotRepository>
      <id>${portvakt.snapshot.repository.id}</id>
      <url>${portvakt.snapshot.repository.url}</url>
    </snapshotRepository>
  </distributionManagement>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>se.portvakt</groupId>
        <artifactId>portvakt-sdk-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>se.portvakt</groupId>
        <artifactId>portvakt-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- One Nimbus version for the core and Spring Security (the one Spring Security declares). -->
      <dependency>
        <groupId>com.nimbusds</groupId>
        <artifactId>nimbus-jose-jwt</artifactId>
        <version>${nimbus-jose-jwt.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
            <compilerArgs>
              <arg>-Xlint:all,-processing,-serial,-try</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-failsafe-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-antrun-plugin</artifactId>
          <version>${maven-antrun-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <!-- Every plugin version is pinned (pluginManagement above). -->
                <requirePluginVersions>
                  <banLatest>true</banLatest>
                  <banRelease>true</banRelease>
                  <banSnapshots>true</banSnapshots>
                </requirePluginVersions>
                <!-- No SNAPSHOT dependencies, apart from this reactor's own modules. -->
                <requireReleaseDeps>
                  <onlyWhenRelease>false</onlyWhenRelease>
                  <excludes>
                    <exclude>se.portvakt:*</exclude>
                  </excludes>
                </requireReleaseDeps>
                <requireUpperBoundDeps/>
                <dependencyConvergence/>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!--
        License check (verify): every runtime dependency (compile and runtime scope; test,
        provided and system excluded) must be under a permissive license. A dependency with
        several licenses passes when one of them is allowed (logback: EPL-2.0 or LGPL-2.1;
        jakarta.annotation: EPL-2.0 or GPL-2.0 with the Classpath Exception). GPL and AGPL alone,
        and a missing license, fail the build. The license names of the POMs are merged into SPDX
        ids first; THIRD-PARTY.txt (target/generated-sources/license) lists the result.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>third-party-licenses</id>
            <phase>verify</phase>
            <goals>
              <goal>add-third-party</goal>
            </goals>
            <configuration>
              <excludedScopes>test,provided,system</excludedScopes>
              <excludedGroups>^se.portvakt</excludedGroups>
              <failOnMissing>true</failOnMissing>
              <failOnBlacklist>true</failOnBlacklist>
              <includedLicenses>
                <includedLicense>Apache-2.0</includedLicense>
                <includedLicense>MIT</includedLicense>
                <includedLicense>BSD-2-Clause</includedLicense>
                <includedLicense>BSD-3-Clause</includedLicense>
                <includedLicense>EPL-1.0</includedLicense>
                <includedLicense>EPL-2.0</includedLicense>
                <includedLicense>CC0-1.0</includedLicense>
              </includedLicenses>
              <licenseMerges>
                <licenseMerge>Apache-2.0|Apache License, Version 2.0|Apache License, version 2.0|The Apache Software License, Version 2.0|The Apache License, Version 2.0|Apache License 2.0|Apache 2.0|Apache 2|Apache License Version 2.0</licenseMerge>
                <licenseMerge>MIT|MIT License|The MIT License|The MIT License (MIT)</licenseMerge>
                <licenseMerge>BSD-3-Clause|BSD License 3|The BSD 3-Clause License|BSD 3-Clause|New BSD License</licenseMerge>
                <licenseMerge>BSD-2-Clause|BSD 2-Clause|The BSD 2-Clause License</licenseMerge>
                <licenseMerge>EPL-2.0|EPL 2.0|Eclipse Public License v2.0|Eclipse Public License - v 2.0|Eclipse Public License 2.0</licenseMerge>
                <licenseMerge>EPL-1.0|EPL 1.0|Eclipse Public License v1.0|Eclipse Public License - v 1.0</licenseMerge>
                <licenseMerge>LGPL-2.1-only|GNU Lesser General Public License|LGPL 2.1|GNU Lesser General Public License, version 2.1</licenseMerge>
                <licenseMerge>GPL-2.0-with-classpath-exception|GPL2 w/ CPE|GNU General Public License, version 2 with the GNU Classpath Exception</licenseMerge>
              </licenseMerges>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Release artifacts (mvn -Prelease package / deploy): a sources jar and a javadoc jar next to
      each SDK jar. The Java demo skips both and is never deployed.
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <doclint>all,-missing</doclint>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
